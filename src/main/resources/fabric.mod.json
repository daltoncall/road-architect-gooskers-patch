{
  "schemaVersion": 1,
  "id": "roadarchitect",
  "version": "${version}",
  "name": "Road Architect: Goosker's Patch ${version}",
  "description": "Unofficial RoadArchitect 1.6.6 stability and terrain-generation patch for Fabric 1.20.1.",
  "authors": [
    "0xCoDSnet"
  ],
  "contributors": [
    "Dalton Call / Goosker"
  ],
  "contact": {
    "homepage": "https://github.com/Shadscure/RoadArchitect",
    "sources": "https://github.com/Shadscure/RoadArchitect",
    "issues": "https://github.com/Shadscure/RoadArchitect/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/roadarchitect/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.oxcodsnet.roadarchitect.fabric.RoadArchitectFabric"
    ],
    "client": [
      "net.oxcodsnet.roadarchitect.fabric.client.RoadArchitectClientFabric"
    ],
    "fabric-datagen": [
      "net.oxcodsnet.roadarchitect.fabric.datagen.RoadArchitectDataGenerator"
    ],
    "modmenu": [
      "net.oxcodsnet.roadarchitect.fabric.config.RAConfigModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "cloth-config2": ">=11.1.136"
  },
  "suggests": {
    "modmenu": "7.2.2",
    "terrain_slabs": "*"
  },
  "mixins": [
    "roadarchitect.tree-protection.mixins.json"
